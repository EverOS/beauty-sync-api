# Copie este arquivo para .env e preencha com os seus valores:
#   cp .env.example .env

# Porta em que a API vai rodar
PORT=3000

# Conexão com o PostgreSQL (usuário, senha e banco do docker-compose.yml)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO?schema=public"

# Chave usada para assinar os tokens JWT (use um texto longo e aleatório)
JWT_SECRET="troque-por-uma-chave-secreta"